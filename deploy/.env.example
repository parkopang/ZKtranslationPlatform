# 生产配置模板（不要把真实密钥提交到仓库）
# cp .env.example .env && chmod 600 .env

HTTP_PORT=80

# 0.2.6 will be replaced with immutable registry digests after image acceptance.
BACKEND_IMAGE=jszt-tcr.tencentcloudcr.com/psp/translation-platform-backend:0.2.6
FRONTEND_IMAGE=jszt-tcr.tencentcloudcr.com/psp/translation-platform-frontend:0.2.6
NGINX_IMAGE=jszt-tcr.tencentcloudcr.com/psp/translation-platform-nginx:0.2.6

# Backend security and registration
ADMIN_KEY=replace-with-a-long-random-admin-key
CORS_ORIGIN=https://your-h5-domain.example
# 微信公众号菜单和小程序 web-view 使用管理员在“入口管理”中生成的 HTTPS 地址。
# 每个公众号/小程序使用不同的 entry 编码；不要把下面的示例地址直接发布：
# https://your-h5-domain.example/doctor?entry=<entry-code>&channel=public-account
# https://your-h5-domain.example/doctor?entry=<entry-code>&channel=mini-program
# 先在微信后台把 your-h5-domain.example 加入网页授权域名/业务域名；不要把管理员
# 地址（?workspace=admin）挂到菜单，也不要把 openid、session_key 或实名资料放入 URL。
PII_ENCRYPTION_KEY=replace-with-a-random-32-byte-secret-or-64-char-hex-key
REGISTRATION_MODE=standard
SEED_DEMO=false
VITE_API_BASE_URL=/api

# Model primary/standby chain. The first provider receives requests; when it
# times out, is rate-limited, unavailable or rejects the key, the next one is tried.
LLM_PROVIDER_CHAIN=openai_compatible,bigmodel
LLM_PROVIDER=openai_compatible
LLM_FALLBACK_PROVIDER=
OPENAI_COMPATIBLE_KEY_TYPE=platform_api
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://provider.example.invalid/v2/openai/completions
OPENAI_COMPATIBLE_MODEL=plmf/glm-5.3-flash
# Optional BigModel standby (use coding_plan only with the Coding Plan endpoint).
BIGMODEL_KEY_TYPE=coding_plan
BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=https://bigmodel.example.test/api/coding/paas/v4/chat/completions
BIGMODEL_MODEL=glm-5.3-flash
LLM_MAX_CONCURRENCY=2
LLM_RATE_LIMIT_DELAY_MS=60000
LLM_FAILURE_COOLDOWN_MS=60000
LLM_REQUEST_TIMEOUT_MS=30000
LLM_TOTAL_TIMEOUT_MS=120000
LLM_MAX_TOKENS=4096
LLM_RETRY_ATTEMPTS=5
LLM_RETRY_BASE_MS=500
LLM_RETRY_MAX_MS=10000
# Optional per-provider overrides. Prefix the shared name with
# OPENAI_COMPATIBLE_, BIGMODEL_ or MINIMAX_; omitted values use LLM_*.
# Example: OPENAI_COMPATIBLE_RETRY_ATTEMPTS=3
# Example: BIGMODEL_FAILURE_COOLDOWN_MS=90000
PRETRANSLATE_JOB_ATTEMPTS=3
PRETRANSLATE_RETRY_DELAY_MS=60000
PRETRANSLATE_WORKERS=2

# MySQL. Use the internal address on the deployment network. The external
# address is for allowlisted office-network maintenance and migration only.
DB_ENGINE=mysql
MYSQL_HOST=replace-with-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=replace-with-database-name
MYSQL_USER=replace-with-database-name
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_POOL_SIZE=10
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_SSL=false
# External maintenance endpoint (do not put it in MYSQL_HOST on the app host):
# MYSQL_EXTERNAL_HOST=replace-with-maintenance-mysql-host
# MYSQL_EXTERNAL_PORT=23778

# Shared internal Redis. DB 20 is reserved for this platform.
REDIS_URL=redis://:replace-with-redis-password@replace-with-redis-host:6379/20
REDIS_PASSWORD=replace-with-redis-password
QUEUE_KEY_PREFIX=translation

# Tencent COS (S3-compatible API). Keep the public bucket base URL separate
# from the signing endpoint; the bucket should remain private.
COS_BASE_URL=https://replace-with-cos-host
COS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
COS_BUCKET=replace-with-cos-bucket
COS_REGION=ap-guangzhou
COS_ACCESS_KEY=
COS_SECRET_KEY=
S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
S3_BUCKET=replace-with-cos-bucket
S3_REGION=ap-guangzhou
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional resource limits for a small production trial (10 simultaneous users)
BACKEND_MEMORY_LIMIT=768m
BACKEND_CPUS=1.5
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPUS=0.5
NGINX_MEMORY_LIMIT=128m
NGINX_CPUS=0.5
